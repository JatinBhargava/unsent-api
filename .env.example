POSTGRES_DB=unsent_db
POSTGRES_USER=unsent_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433


SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/unsent_db
SPRING_DATASOURCE_USERNAME=unsent_user
SPRING_DATASOURCE_PASSWORD=change_me


SPRING_PROFILES_ACTIVE=dev

APP_FRONTEND_URL=http://localhost:5173
JWT_SECRET=change_me
CLIENT_ID=change_me
CLIENT_SECRET=change_me
OPENAI_API_KEY=change_me

# Postcard delivery (SMTP). Credentials are provider-specific:
#   Gmail  — username is your address, password is a 16-char App Password
#            (needs 2-Step Verification), and POSTCARD_FROM_ADDRESS must match
#            the username: Gmail rewrites any other From header.
#   Resend — username is the literal string "resend", password is the API key,
#            and POSTCARD_FROM_ADDRESS must be on a verified domain.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change_me
MAIL_PASSWORD=change_me

POSTCARD_FROM_ADDRESS=change_me
POSTCARD_FROM_NAME=Unsent
POSTCARD_MAX_PER_HOUR=10

# Put the signed-in user's address in the From header. Leave false on Gmail (it
# rewrites From to the authenticated account) and on any provider where the
# user's domain is not verified.
POSTCARD_SEND_AS_USER=false
